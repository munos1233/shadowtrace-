# ============================================================================
# Live provider overrides (ISSUE-088)
#
# Usage:
#   cp infra/.env.live.example .env.live
#   # fill in credentials, then rebuild/restart stack
#
# Loaded automatically by compose when present (required: false).
# ============================================================================
SIMULATION_ENABLED=false
LLM_MODE=openai_compatible
# Chat-completions prefix, e.g. Volcengine Ark: https://ark.cn-beijing.volces.com/api/v3
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_PRIMARY_MODEL=
SOURCE_MODE=sangfor_xdr
DISPOSITION_MODE=live_xdr
DISPOSITION_ADAPTER_KIND=sangfor_xdr
TOOL_MODE=live
ALLOW_LIVE_SIDE_EFFECTS=true
BLOCK_LIVE_ACTION_EXECUTION=false
ALLOW_XDR_WRITEBACK=true
SANGFOR_XDR_BASE_URL=
SANGFOR_AUTH_CODE=
# Or use AK/SK instead of SANGFOR_AUTH_CODE:
SANGFOR_ACCESS_KEY=
SANGFOR_SECRET_KEY=
SANGFOR_TLS_VERIFY=true
