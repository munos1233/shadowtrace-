# ============================================================================
# ShadowTrace Compose 端口映射（ISSUE-088）
#
# 复制为 infra/.env 并修改端口即可覆盖 docker-compose.yml 中的 ${VAR} 默认值。
# 注意：此文件仅用于 compose 变量替换（端口映射）。
#       应用层变量请修改项目根目录的 .env.example（或 .env）。
# ============================================================================
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
MOCK_XDR_PORT=8100
OPENSEARCH_PORT=9200
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
