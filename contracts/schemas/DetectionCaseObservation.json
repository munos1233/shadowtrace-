{
  "$defs": {
    "CandidateDetection": {
      "additionalProperties": false,
      "description": "Shadow-only detection candidate — never creates Event/SourceAlert.",
      "properties": {
        "candidate_detection_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Detection Id",
          "type": "string"
        },
        "source_tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Tenant Id",
          "type": "string"
        },
        "detection_scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Detection Scope Id",
          "type": "string"
        },
        "package_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "package_version": {
          "minimum": 1,
          "title": "Package Version",
          "type": "integer"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minimum": 1,
          "title": "Rule Version",
          "type": "integer"
        },
        "operator": {
          "$ref": "#/$defs/RuleOperatorKind"
        },
        "group_key": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Group Key",
          "type": "object"
        },
        "cutoff_at": {
          "format": "date-time",
          "title": "Cutoff At",
          "type": "string"
        },
        "window_kind": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Window Kind",
          "type": "string"
        },
        "matched_value": {
          "minimum": 0,
          "title": "Matched Value",
          "type": "number"
        },
        "severity": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        },
        "shadow_only": {
          "const": true,
          "default": true,
          "title": "Shadow Only",
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/CandidateDetectionProvenance"
        },
        "content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "candidate_detection_id",
        "source_tenant_id",
        "detection_scope_id",
        "package_id",
        "package_version",
        "rule_id",
        "rule_version",
        "operator",
        "cutoff_at",
        "window_kind",
        "matched_value",
        "severity",
        "provenance",
        "content_hash",
        "idempotency_key"
      ],
      "title": "CandidateDetection",
      "type": "object"
    },
    "CandidateDetectionProvenance": {
      "additionalProperties": false,
      "description": "Evidence anchors for shadow candidate output.",
      "properties": {
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Observation Ids",
          "type": "array"
        },
        "snapshot_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Snapshot Ids",
          "type": "array"
        },
        "window_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Start"
        },
        "window_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window End"
        },
        "model_release_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Release Id"
        },
        "model_release_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Release Hash"
        },
        "calibration_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Version"
        },
        "threshold_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Version"
        },
        "detection_score": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Score"
        },
        "feature_contract_version": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Contract Version"
        },
        "snapshot_content_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Content Hash"
        },
        "source_watermark": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Watermark"
        },
        "baseline_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Id"
        },
        "baseline_content_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Content Hash"
        },
        "snapshot_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Revision"
        },
        "contributing_features": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 16,
          "title": "Contributing Features",
          "type": "array"
        },
        "sequence_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Id"
        },
        "sequence_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Hash"
        },
        "max_step_gap_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Step Gap Seconds"
        },
        "ordered_observation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Ordered Observation Ids",
          "type": "array"
        },
        "sequence_step_matches": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 32,
          "title": "Sequence Step Matches",
          "type": "array"
        },
        "match_explanation": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Explanation"
        }
      },
      "title": "CandidateDetectionProvenance",
      "type": "object"
    },
    "DetectionResourceMetrics": {
      "additionalProperties": false,
      "description": "Per-case shadow runtime resource accounting.",
      "properties": {
        "rules_evaluated": {
          "default": 0,
          "minimum": 0,
          "title": "Rules Evaluated",
          "type": "integer"
        },
        "observations_scanned": {
          "default": 0,
          "minimum": 0,
          "title": "Observations Scanned",
          "type": "integer"
        },
        "runtime_error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Runtime Error Count",
          "type": "integer"
        },
        "candidate_count": {
          "default": 0,
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "replay_duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Replay Duration Ms",
          "type": "integer"
        }
      },
      "title": "DetectionResourceMetrics",
      "type": "object"
    },
    "DetectionRuleRuntimeError": {
      "additionalProperties": false,
      "description": "Typed runtime failure — never silently treated as benign.",
      "properties": {
        "error_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Error Id",
          "type": "string"
        },
        "source_tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Tenant Id",
          "type": "string"
        },
        "package_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "error_category": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Error Category",
          "type": "string"
        },
        "error_message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Error Message",
          "type": "string"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "error_id",
        "source_tenant_id",
        "package_id",
        "error_category",
        "error_message"
      ],
      "title": "DetectionRuleRuntimeError",
      "type": "object"
    },
    "RuleOperatorKind": {
      "description": "Phase A operators supported by the minimal runtime.",
      "enum": [
        "event_match",
        "event_count",
        "event_sequence",
        "value_count",
        "statistical_anomaly"
      ],
      "title": "RuleOperatorKind",
      "type": "string"
    },
    "SliceType": {
      "description": "Evaluation slices; extend via reviewed schema revision only (#618 / #642).",
      "enum": [
        "threat",
        "benign",
        "unevaluable",
        "security",
        "knowledge",
        "agentic",
        "coordination"
      ],
      "title": "SliceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Shadow replay observation for one detection evaluation case.",
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "slice_type": {
      "$ref": "#/$defs/SliceType"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateDetection"
      },
      "title": "Candidates",
      "type": "array"
    },
    "runtime_errors": {
      "items": {
        "$ref": "#/$defs/DetectionRuleRuntimeError"
      },
      "title": "Runtime Errors",
      "type": "array"
    },
    "resource_metrics": {
      "$ref": "#/$defs/DetectionResourceMetrics"
    },
    "observation_available": {
      "default": true,
      "title": "Observation Available",
      "type": "boolean"
    },
    "replay_cutoff_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replay Cutoff At"
    },
    "replay_notes": {
      "default": "",
      "maxLength": 512,
      "title": "Replay Notes",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "slice_type"
  ],
  "title": "DetectionCaseObservation",
  "type": "object"
}
