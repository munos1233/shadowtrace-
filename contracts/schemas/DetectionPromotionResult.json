{
  "$defs": {
    "DetectionContextProjectionError": {
      "additionalProperties": false,
      "description": "Structured detection context projection failure surfaced on promotion results.",
      "properties": {
        "reason": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 512,
          "title": "Message",
          "type": "string"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        }
      },
      "required": [
        "reason"
      ],
      "title": "DetectionContextProjectionError",
      "type": "object"
    },
    "DetectionPromotionReasonCode": {
      "description": "Machine-readable promotion failure / gate reason codes.",
      "enum": [
        "no_active_approval",
        "artifact_hash_mismatch",
        "candidate_binding_mismatch",
        "package_hash_mismatch",
        "package_not_shadow_active",
        "candidate_not_found",
        "candidate_not_shadow",
        "candidate_hash_mismatch",
        "scope_mismatch",
        "derived_connector_recursion",
        "ingest_failed",
        "package_transition_blocked",
        "promotion_superseded",
        "context_projection_failed"
      ],
      "title": "DetectionPromotionReasonCode",
      "type": "string"
    },
    "DetectionPromotionRecord": {
      "additionalProperties": false,
      "description": "Immutable promotion ledger row (append-only status transitions).",
      "properties": {
        "promotion_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Promotion Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "promotion_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Promotion Key",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DetectionPromotionStatus"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "candidate_detection_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Detection Id",
          "type": "string"
        },
        "candidate_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Candidate Content Hash",
          "type": "string"
        },
        "package_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "package_version": {
          "minimum": 1,
          "title": "Package Version",
          "type": "integer"
        },
        "package_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Package Content Hash",
          "type": "string"
        },
        "detection_scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Detection Scope Id",
          "type": "string"
        },
        "scope_revision_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Revision Id"
        },
        "derived_connector_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived Connector Id"
        },
        "source_record_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "link_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Link Revision",
          "type": "integer"
        },
        "ingest_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedIngestResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_projection_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetectionContextProjectionError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/DetectionPromotionReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "reason_message": {
          "default": "",
          "maxLength": 1024,
          "title": "Reason Message",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "promotion_id",
        "tenant_id",
        "promotion_key",
        "status",
        "decision_id",
        "candidate_detection_id",
        "candidate_content_hash",
        "package_id",
        "package_version",
        "package_content_hash",
        "detection_scope_id"
      ],
      "title": "DetectionPromotionRecord",
      "type": "object"
    },
    "DetectionPromotionStatus": {
      "description": "Durable promotion saga states.",
      "enum": [
        "pending",
        "source_persisted",
        "event_linked",
        "completed",
        "retry",
        "dead",
        "manual"
      ],
      "title": "DetectionPromotionStatus",
      "type": "string"
    },
    "SourceIngestCorrelationOutcome": {
      "description": "Canonical correlation outcome produced exclusively by EventService.",
      "enum": [
        "created",
        "merged",
        "duplicate",
        "idempotent",
        "promoted",
        "related_only"
      ],
      "title": "SourceIngestCorrelationOutcome",
      "type": "string"
    },
    "SourceIngestLinkDisposition": {
      "description": "Link role disposition surfaced on typed ingest results.",
      "enum": [
        "primary",
        "provisional",
        "related"
      ],
      "title": "SourceIngestLinkDisposition",
      "type": "string"
    },
    "TypedIngestResult": {
      "additionalProperties": false,
      "description": "EventService-owned ingest result contract extended for #629.",
      "properties": {
        "source_record_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "accepted": {
          "default": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "created": {
          "default": false,
          "title": "Created",
          "type": "boolean"
        },
        "promoted": {
          "default": false,
          "title": "Promoted",
          "type": "boolean"
        },
        "related_only": {
          "default": false,
          "title": "Related Only",
          "type": "boolean"
        },
        "idempotent": {
          "default": false,
          "title": "Idempotent",
          "type": "boolean"
        },
        "duplicate": {
          "default": false,
          "title": "Duplicate",
          "type": "boolean"
        },
        "source_object_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Object Id"
        },
        "source_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision"
        },
        "correlation_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceIngestCorrelationOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Revision"
        },
        "link_disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceIngestLinkDisposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_message": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        }
      },
      "required": [
        "source_record_id"
      ],
      "title": "TypedIngestResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Service output for one promotion attempt (terminal or resumable).",
  "properties": {
    "promotion_id": {
      "title": "Promotion Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DetectionPromotionStatus"
    },
    "record": {
      "$ref": "#/$defs/DetectionPromotionRecord"
    },
    "ingest_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/TypedIngestResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resumed": {
      "default": false,
      "title": "Resumed",
      "type": "boolean"
    },
    "context_projection_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/DetectionContextProjectionError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "promotion_id",
    "status",
    "record"
  ],
  "title": "DetectionPromotionResult",
  "type": "object"
}
