{
  "$defs": {
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StorylineClaimRef": {
      "additionalProperties": false,
      "description": "Stable navigation id for an evidence-grounded storyline proposition (ISSUE-116).",
      "properties": {
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "proposition_kind": {
          "default": "timeline_entry",
          "enum": [
            "timeline_entry",
            "phase_summary"
          ],
          "title": "Proposition Kind",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Evidence Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 16,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "ordinal": {
          "default": 0,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "claim_id"
      ],
      "title": "StorylineClaimRef",
      "type": "object"
    },
    "StorylineGeneratedBy": {
      "enum": [
        "llm",
        "rule"
      ],
      "title": "StorylineGeneratedBy",
      "type": "string"
    },
    "StorylineGroundingStatus": {
      "description": "How storyline claims are grounded to evidence (ISSUE-116 Phase B / ISSUE-244).",
      "enum": [
        "evidence_grounded",
        "legacy_evidence_grounded",
        "claim_refs_unavailable",
        "ungrounded"
      ],
      "title": "StorylineGroundingStatus",
      "type": "string"
    },
    "StorylinePhase": {
      "additionalProperties": false,
      "properties": {
        "phase_order": {
          "title": "Phase Order",
          "type": "integer"
        },
        "phase_name": {
          "$ref": "#/$defs/StorylinePhaseName"
        },
        "tactic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tactic"
        },
        "narrative": {
          "default": "",
          "title": "Narrative",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/TimelineEntry"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "phase_order",
        "phase_name"
      ],
      "title": "StorylinePhase",
      "type": "object"
    },
    "StorylinePhaseName": {
      "enum": [
        "initial_access",
        "collection",
        "staging",
        "exfiltration",
        "post_action"
      ],
      "title": "StorylinePhaseName",
      "type": "string"
    },
    "TimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "technique_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Id"
        },
        "severity_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "timestamp",
        "description",
        "evidence_id"
      ],
      "title": "TimelineEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "storyline_id": {
      "title": "Storyline Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "narrative_summary": {
      "title": "Narrative Summary",
      "type": "string"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/StorylinePhase"
      },
      "title": "Phases",
      "type": "array"
    },
    "generated_by": {
      "$ref": "#/$defs/StorylineGeneratedBy"
    },
    "schema_version": {
      "default": "1.0",
      "maxLength": 16,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "claim_refs": {
      "items": {
        "$ref": "#/$defs/StorylineClaimRef"
      },
      "title": "Claim Refs",
      "type": "array"
    },
    "grounding_status": {
      "$ref": "#/$defs/StorylineGroundingStatus",
      "default": "legacy_evidence_grounded"
    }
  },
  "required": [
    "storyline_id",
    "event_id",
    "narrative_summary",
    "generated_by"
  ],
  "title": "AttackStoryline",
  "type": "object"
}
