{
  "$defs": {
    "DetectionRuleDefinition": {
      "additionalProperties": false,
      "description": "Single compiled rule within a package.",
      "properties": {
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minimum": 1,
          "title": "Rule Version",
          "type": "integer"
        },
        "operator": {
          "$ref": "#/$defs/RuleOperatorKind"
        },
        "feature_contract_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Feature Contract Version",
          "type": "string"
        },
        "detection_scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Detection Scope Id",
          "type": "string"
        },
        "window_kind": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Window Kind",
          "type": "string"
        },
        "group_key_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Group Key Fields",
          "type": "array"
        },
        "threshold": {
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "severity": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Required Fields",
          "type": "array"
        },
        "missing_data_policy": {
          "$ref": "#/$defs/MissingDataPolicy",
          "default": "skip"
        },
        "match_criteria": {
          "additionalProperties": true,
          "title": "Match Criteria",
          "type": "object"
        },
        "value_field": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Field"
        },
        "max_observation_scan": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Observation Scan",
          "type": "integer"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "operator",
        "feature_contract_version",
        "detection_scope_id",
        "window_kind",
        "group_key_fields",
        "threshold",
        "severity"
      ],
      "title": "DetectionRuleDefinition",
      "type": "object"
    },
    "DetectionRulePackage": {
      "additionalProperties": false,
      "description": "Versioned, compilable rule bundle.",
      "properties": {
        "package_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "source_tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Tenant Id",
          "type": "string"
        },
        "package_version": {
          "minimum": 1,
          "title": "Package Version",
          "type": "integer"
        },
        "runtime_state": {
          "$ref": "#/$defs/DetectionRuleRuntimeState"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/DetectionRuleDefinition"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/DetectionRulePackageProvenance"
        },
        "content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "supersedes_package_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Package Id"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "package_id",
        "source_tenant_id",
        "package_version",
        "runtime_state",
        "rules",
        "provenance",
        "content_hash",
        "idempotency_key"
      ],
      "title": "DetectionRulePackage",
      "type": "object"
    },
    "DetectionRulePackageProvenance": {
      "additionalProperties": false,
      "description": "Authoring and review trace — not a substitute for #630 governance.",
      "properties": {
        "author": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "review_artifact_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Artifact Ref"
        },
        "test_artifact_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Artifact Ref"
        },
        "compiled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compiled At"
        }
      },
      "required": [
        "author"
      ],
      "title": "DetectionRulePackageProvenance",
      "type": "object"
    },
    "DetectionRuleRuntimeState": {
      "description": "Executable package state — not governance approval or production promotion.",
      "enum": [
        "draft",
        "validated",
        "shadow_active",
        "production_active",
        "disabled"
      ],
      "title": "DetectionRuleRuntimeState",
      "type": "string"
    },
    "MissingDataPolicy": {
      "description": "Behavior when required fields or snapshot signal is absent.",
      "enum": [
        "skip",
        "fail",
        "treat_as_zero"
      ],
      "title": "MissingDataPolicy",
      "type": "string"
    },
    "RuleOperatorKind": {
      "description": "Phase A operators supported by the minimal runtime.",
      "enum": [
        "event_match",
        "event_count",
        "event_sequence",
        "value_count",
        "statistical_anomaly"
      ],
      "title": "RuleOperatorKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "page_size": {
      "minimum": 1,
      "title": "Page Size",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/DetectionRulePackage"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "total",
    "page",
    "page_size"
  ],
  "title": "DetectionRulePackageListResult",
  "type": "object"
}
