{
  "$defs": {
    "LlmAdmissibility": {
      "description": "Whether RiskAgent may merge LLM dimension scores (ISSUE-102 Phase B / #675).",
      "enum": [
        "not_used",
        "valid",
        "degraded",
        "invalid"
      ],
      "title": "LlmAdmissibility",
      "type": "string"
    },
    "RiskFactor": {
      "additionalProperties": false,
      "properties": {
        "factor_name": {
          "title": "Factor Name",
          "type": "string"
        },
        "weight": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "raw_score": {
          "title": "Raw Score",
          "type": "number"
        },
        "weighted_score": {
          "title": "Weighted Score",
          "type": "number"
        },
        "reasoning": {
          "default": "",
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "factor_name",
        "weight",
        "raw_score",
        "weighted_score"
      ],
      "title": "RiskFactor",
      "type": "object"
    },
    "ScoringMode": {
      "enum": [
        "llm_and_rule",
        "rule_only"
      ],
      "title": "ScoringMode",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "integer"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "risk_factors": {
      "items": {
        "$ref": "#/$defs/RiskFactor"
      },
      "title": "Risk Factors",
      "type": "array"
    },
    "possible_false_positive": {
      "default": false,
      "title": "Possible False Positive",
      "type": "boolean"
    },
    "scoring_mode": {
      "$ref": "#/$defs/ScoringMode"
    },
    "evidence_limited": {
      "default": false,
      "title": "Evidence Limited",
      "type": "boolean"
    },
    "severity_floor_applied": {
      "default": false,
      "title": "Severity Floor Applied",
      "type": "boolean"
    },
    "source_risk_baseline": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Risk Baseline"
    },
    "source_scale_unnormalized": {
      "default": false,
      "title": "Source Scale Unnormalized",
      "type": "boolean"
    },
    "high_source_evidence_limited": {
      "default": false,
      "title": "High Source Evidence Limited",
      "type": "boolean"
    },
    "llm_admissibility": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmAdmissibility"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence_cap_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence Cap Version"
    },
    "verdict_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Verdict Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "risk_score",
    "severity",
    "confidence",
    "scoring_mode"
  ],
  "title": "RiskAssessment",
  "type": "object"
}
