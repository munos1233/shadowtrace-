{
  "$defs": {
    "AgenticCaseObservation": {
      "additionalProperties": false,
      "description": "Structured ReAct shadow replay observation for #642 Phase B scorers.",
      "properties": {
        "expectation_kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Expectation Kind",
          "type": "string"
        },
        "production_store_mutated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production Store Mutated"
        },
        "shadow_namespace_used": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shadow Namespace Used"
        },
        "pivot_completed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pivot Completed"
        },
        "typed_artifact_produced": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typed Artifact Produced"
        },
        "step_count_within_bounds": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Count Within Bounds"
        },
        "evidence_refs_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Refs Valid"
        },
        "raw_cot_persisted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Cot Persisted"
        },
        "cross_tenant_denied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross Tenant Denied"
        },
        "budget_race_rejected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Race Rejected"
        },
        "degraded_fail_closed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degraded Fail Closed"
        },
        "unsupported_tool_denied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Tool Denied"
        },
        "dependency_degraded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Degraded"
        }
      },
      "required": [
        "expectation_kind"
      ],
      "title": "AgenticCaseObservation",
      "type": "object"
    },
    "CaseObservation": {
      "additionalProperties": false,
      "description": "Deterministic mock-replay observation for one evaluation case.",
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "slice_type": {
          "$ref": "#/$defs/SliceType"
        },
        "observed_case_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Case Label"
        },
        "observed_final_verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Final Verdict"
        },
        "observed_risk_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Risk Score"
        },
        "observed_attack_techniques": {
          "items": {
            "type": "string"
          },
          "title": "Observed Attack Techniques",
          "type": "array"
        },
        "observed_incident_group_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Incident Group Id"
        },
        "observation_available": {
          "default": true,
          "title": "Observation Available",
          "type": "boolean"
        },
        "replay_notes": {
          "default": "",
          "maxLength": 512,
          "title": "Replay Notes",
          "type": "string"
        },
        "security": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecurityCaseObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "knowledge": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnowledgeCaseObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "agentic": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgenticCaseObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coordination": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoordinationCaseObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "case_id",
        "slice_type"
      ],
      "title": "CaseObservation",
      "type": "object"
    },
    "ConfidenceInterval": {
      "additionalProperties": false,
      "description": "Wilson score interval for a proportion metric.",
      "properties": {
        "lower": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Upper",
          "type": "number"
        },
        "level": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Level",
          "type": "number"
        },
        "method": {
          "default": "wilson",
          "maxLength": 32,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ConfidenceInterval",
      "type": "object"
    },
    "CoordinationCaseObservation": {
      "additionalProperties": false,
      "description": "Structured task/artifact replay observation for #642 Phase C scorers.",
      "properties": {
        "expectation_kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Expectation Kind",
          "type": "string"
        },
        "stale_fencing_denied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Fencing Denied"
        },
        "duplicate_logical_artifact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Logical Artifact"
        },
        "content_hash_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash Match"
        },
        "attempt_recorded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Recorded"
        },
        "cross_tenant_denied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross Tenant Denied"
        },
        "projection_rejected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Rejected"
        },
        "forged_grant_rejected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forged Grant Rejected"
        },
        "terminal_transition_idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Transition Idempotent"
        },
        "manual_resolution_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Resolution Required"
        },
        "blind_retry_blocked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blind Retry Blocked"
        },
        "dependency_degraded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Degraded"
        }
      },
      "required": [
        "expectation_kind"
      ],
      "title": "CoordinationCaseObservation",
      "type": "object"
    },
    "EvaluationAggregateMetrics": {
      "additionalProperties": false,
      "description": "Dataset-level rollups with explicit denominators.",
      "properties": {
        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "pass_count": {
          "minimum": 0,
          "title": "Pass Count",
          "type": "integer"
        },
        "fail_count": {
          "minimum": 0,
          "title": "Fail Count",
          "type": "integer"
        },
        "unevaluable_count": {
          "minimum": 0,
          "title": "Unevaluable Count",
          "type": "integer"
        },
        "error_count": {
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "pass_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Pass Rate",
          "type": "number"
        },
        "required_scorer_error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Required Scorer Error Count",
          "type": "integer"
        }
      },
      "required": [
        "case_count",
        "pass_count",
        "fail_count",
        "unevaluable_count",
        "error_count",
        "pass_rate"
      ],
      "title": "EvaluationAggregateMetrics",
      "type": "object"
    },
    "EvaluationCaseResult": {
      "additionalProperties": false,
      "description": "Aggregated per-case evaluation output.",
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "truth_id": {
          "minLength": 1,
          "title": "Truth Id",
          "type": "string"
        },
        "truth_revision": {
          "minimum": 1,
          "title": "Truth Revision",
          "type": "integer"
        },
        "truth_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Truth Content Hash",
          "type": "string"
        },
        "slice_type": {
          "$ref": "#/$defs/SliceType"
        },
        "observation": {
          "$ref": "#/$defs/CaseObservation"
        },
        "scorer_results": {
          "items": {
            "$ref": "#/$defs/EvaluationScorerResult"
          },
          "title": "Scorer Results",
          "type": "array"
        },
        "case_status": {
          "$ref": "#/$defs/EvaluationRunStatus"
        },
        "unevaluable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unevaluable Reason"
        },
        "critical": {
          "default": false,
          "description": "When true, gate may fail closed regardless of aggregate pass_rate (#642).",
          "title": "Critical",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "truth_id",
        "truth_revision",
        "truth_content_hash",
        "slice_type",
        "observation",
        "case_status"
      ],
      "title": "EvaluationCaseResult",
      "type": "object"
    },
    "EvaluationGateDiff": {
      "additionalProperties": false,
      "description": "Machine-readable threshold comparison delta.",
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "actual": {
          "default": null,
          "title": "Actual"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "EvaluationGateDiff",
      "type": "object"
    },
    "EvaluationGateResult": {
      "additionalProperties": false,
      "description": "Threshold/baseline gate outcome.",
      "properties": {
        "verdict": {
          "$ref": "#/$defs/GateVerdict"
        },
        "manifest_version": {
          "default": "",
          "maxLength": 64,
          "title": "Manifest Version",
          "type": "string"
        },
        "manifest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Path"
        },
        "diffs": {
          "items": {
            "$ref": "#/$defs/EvaluationGateDiff"
          },
          "title": "Diffs",
          "type": "array"
        },
        "quarantine_active": {
          "default": false,
          "description": "True when an active (non-expired) quarantine overrides threshold failures; consumers must read diffs alongside verdict.",
          "title": "Quarantine Active",
          "type": "boolean"
        }
      },
      "required": [
        "verdict"
      ],
      "title": "EvaluationGateResult",
      "type": "object"
    },
    "EvaluationQualityReport": {
      "additionalProperties": false,
      "description": "Machine-readable offline quality report bound to one evaluation run.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "dataset_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Dataset Content Hash",
          "type": "string"
        },
        "code_sha": {
          "maxLength": 64,
          "minLength": 7,
          "title": "Code Sha",
          "type": "string"
        },
        "release_refs": {
          "$ref": "#/$defs/EvaluationReleaseRefs"
        },
        "sample_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Sample Counts",
          "type": "object"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/QualityMetricValue"
          },
          "title": "Metrics",
          "type": "array"
        },
        "grouping_scorer_summaries": {
          "items": {
            "$ref": "#/$defs/GroupingScorerSummary"
          },
          "title": "Grouping Scorer Summaries",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "dataset_content_hash",
        "code_sha"
      ],
      "title": "EvaluationQualityReport",
      "type": "object"
    },
    "EvaluationReleaseRefs": {
      "additionalProperties": false,
      "description": "Pinned release identifiers for reproducibility.",
      "properties": {
        "model_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Release Id"
        },
        "prompt_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Release Id"
        },
        "rule_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Release Id"
        },
        "kb_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Release Id"
        },
        "config_profile": {
          "default": "mock_p0",
          "minLength": 1,
          "title": "Config Profile",
          "type": "string"
        }
      },
      "title": "EvaluationReleaseRefs",
      "type": "object"
    },
    "EvaluationRunConfig": {
      "additionalProperties": false,
      "description": "Frozen runner configuration bound into the artifact.",
      "properties": {
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "replay_mode": {
          "default": "mock_deterministic",
          "minLength": 1,
          "title": "Replay Mode",
          "type": "string"
        },
        "replay_fidelity": {
          "default": "slice_adapter_stub",
          "description": "Replay fidelity label. Threat/benign echo expectations; security/knowledge use slice_adapter_stub until investigate replay (#631) is wired.",
          "minLength": 1,
          "title": "Replay Fidelity",
          "type": "string"
        },
        "release_refs": {
          "$ref": "#/$defs/EvaluationReleaseRefs"
        },
        "scorer_ids": {
          "items": {
            "type": "string"
          },
          "title": "Scorer Ids",
          "type": "array"
        },
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        }
      },
      "required": [
        "seed"
      ],
      "title": "EvaluationRunConfig",
      "type": "object"
    },
    "EvaluationRunStatus": {
      "enum": [
        "completed",
        "failed",
        "unevaluable"
      ],
      "title": "EvaluationRunStatus",
      "type": "string"
    },
    "EvaluationScorerResult": {
      "additionalProperties": false,
      "description": "One scorer outcome for a single case.",
      "properties": {
        "scorer_id": {
          "minLength": 1,
          "title": "Scorer Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ScorerOutcome"
        },
        "reason_code": {
          "default": "",
          "maxLength": 128,
          "title": "Reason Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 512,
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "scorer_id",
        "outcome"
      ],
      "title": "EvaluationScorerResult",
      "type": "object"
    },
    "GateVerdict": {
      "enum": [
        "pass",
        "fail",
        "fail_closed"
      ],
      "title": "GateVerdict",
      "type": "string"
    },
    "GroupingScorerSummary": {
      "additionalProperties": false,
      "description": "Rollup for optional severity/ATT&CK/incident grouping scorers.",
      "properties": {
        "scorer_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Scorer Id",
          "type": "string"
        },
        "evaluated_count": {
          "minimum": 0,
          "title": "Evaluated Count",
          "type": "integer"
        },
        "pass_count": {
          "default": 0,
          "minimum": 0,
          "title": "Pass Count",
          "type": "integer"
        },
        "fail_count": {
          "default": 0,
          "minimum": 0,
          "title": "Fail Count",
          "type": "integer"
        },
        "not_applicable_count": {
          "default": 0,
          "minimum": 0,
          "title": "Not Applicable Count",
          "type": "integer"
        },
        "error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        }
      },
      "required": [
        "scorer_id",
        "evaluated_count"
      ],
      "title": "GroupingScorerSummary",
      "type": "object"
    },
    "KnowledgeCaseObservation": {
      "additionalProperties": false,
      "description": "Structured knowledge replay observation for #642 knowledge slice scorers.",
      "properties": {
        "expectation_kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Expectation Kind",
          "type": "string"
        },
        "release_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Id"
        },
        "plan_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Hash"
        },
        "tenant_filter_applied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Filter Applied"
        },
        "citation_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Citation Chunk Ids",
          "type": "array"
        },
        "degraded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degraded"
        },
        "chunk_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Count"
        },
        "empty_results": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Empty Results"
        },
        "dependency_degraded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Degraded"
        }
      },
      "required": [
        "expectation_kind"
      ],
      "title": "KnowledgeCaseObservation",
      "type": "object"
    },
    "MetricDenominator": {
      "additionalProperties": false,
      "description": "Explicit numerator/denominator with missing-truth and error accounting.",
