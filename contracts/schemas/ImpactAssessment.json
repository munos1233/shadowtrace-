{
  "$defs": {
    "BusinessDisruption": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "BusinessDisruption",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Estimated blast radius / reversibility of an action (ISSUE-079).",
  "properties": {
    "action_id": {
      "title": "Action Id",
      "type": "string"
    },
    "impact_score": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Impact Score",
      "type": "integer",
      "description": "0-100 composite impact score"
    },
    "affected_scope": {
      "default": "",
      "title": "Affected Scope",
      "type": "string",
      "description": "Description of affected targets and scope"
    },
    "reversible": {
      "default": true,
      "title": "Reversible",
      "type": "boolean",
      "description": "Whether the action can be rolled back"
    },
    "business_disruption": {
      "$ref": "#/$defs/BusinessDisruption",
      "default": "none",
      "description": "none | low | medium | high"
    },
    "assessment_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assessment Detail",
      "description": "Human-readable assessment rationale"
    },
    "affected_entity_count": {
      "default": 0,
      "title": "Affected Entity Count",
      "type": "integer"
    },
    "affected_targets": {
      "items": {
        "type": "string"
      },
      "title": "Affected Targets",
      "type": "array"
    },
    "assessed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assessed By"
    }
  },
  "required": ["action_id"],
  "title": "ImpactAssessment",
  "type": "object"
}
