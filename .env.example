# ShadowTrace core environment variables (intro §4.7 + ISSUE-001 defaults)
# Copy to .env for local overrides. Defaults target Docker Compose service names.

# --- Application ---
APP_VERSION=0.1.0
APP_ENV=development

# --- API auth (ISSUE-004) ---
# DEV_AUTH_TOKENS maps a bearer token to a fixed Principal for local dev ONLY;
# it is rejected outright when APP_ENV=production. Leave empty in production.
# Optional per-token "tenant_id" scopes governance APIs (ISSUE-125); trusted proxy
# may also send X-Auth-Tenant-Id when TRUSTED_AUTH_PROXY_ENABLED is true.
# Example: {"analyst-token":{"subject":"analyst-1","roles":["analyst"],"tenant_id":"tenant-a"}}
# Compose / e2e default token (mirrored by VITE_DEV_AUTH_TOKEN on the frontend):
DEV_AUTH_TOKENS={"e2e-token":{"subject":"e2e-operator","display_name":"E2E Operator","roles":["analyst","approver"],"tenant_id":"tenant-a"}}
# Only when enabled AND the direct client host is allowlisted are the identity
# headers (X-Auth-Subject / X-Auth-Roles) from a trusted reverse proxy honored.
# In production (APP_ENV=production) an empty or wildcard allowlist prevents
# startup when TRUSTED_AUTH_PROXY_ENABLED=true. Never expose the backend directly
# to the public internet without an ingress that strips forged identity headers.
TRUSTED_AUTH_PROXY_ENABLED=false
# Comma-separated direct client IPs/hostnames of the ingress/proxy (e.g. 10.0.0.5).
# Must be explicit in production; wildcard '*' is rejected at startup.
TRUSTED_PROXY_ALLOWLIST=
# Exact browser Origin allowlist for Socket.IO handshakes (comma-separated).
# Development uses localhost defaults when empty. Production requires an explicit
# non-wildcard list and refuses startup when this value is empty or contains '*'.
SOCKETIO_CORS_ALLOWED_ORIGINS=

# Frontend (Vite) — used at build time for Compose image and local pnpm dev.
VITE_DEV_AUTH_TOKEN=e2e-token
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SOCKET_URL=http://localhost:8000
VITE_AUTH_SUBJECT=e2e-operator
# Optional: override UI role hints (must match DEV_AUTH_TOKENS roles for the bearer token).
# Example analyst-only: VITE_AUTH_ROLES=analyst
# Example approver: VITE_AUTH_ROLES=analyst,approver
# VITE_AUTH_ROLES=
VITE_APPROVER_DISPLAY=E2E Operator

# --- Storage (P0 hard deps) ---
DATABASE_URL=postgresql+asyncpg://shadowtrace:shadowtrace@postgres:5432/shadowtrace
REDIS_URL=redis://redis:6379/0

# --- Source / ingestion ---
SOURCE_MODE=mock_xdr
SOURCE_READ_ONLY=true
# Mock XDR periodic poll scheduler (ISSUE-107). Default off; also requires
# `docker compose --profile scheduler` / `make up SCHEDULER=1` to start Beat.
INGESTION_SCHEDULER_ENABLED=false
INGESTION_POLL_INTERVAL_S=60

# --- Behavior observation projection retry (ISSUE-156) ---
# Default off; when enabled registers Beat task on ingestion queue (scheduler profile).
BEHAVIOR_OBSERVATION_RETRY_ENABLED=false
BEHAVIOR_OBSERVATION_RETRY_INTERVAL_S=120
BEHAVIOR_OBSERVATION_RETRY_BATCH_LIMIT=50

# --- Auto-investigate durable intent (ISSUE-108 / #612) ---
# Default off; when enabled also registers Beat dispatch/reconcile tasks.
AUTO_INVESTIGATE_ENABLED=false
AUTO_INVESTIGATE_MIN_SEVERITY=medium
# Comma-separated event types; empty = all eligible types.
AUTO_INVESTIGATE_EVENT_TYPES=
AUTO_INVESTIGATE_PROVISIONAL_WINDOW_S=300
AUTO_INVESTIGATE_CLAIM_LEASE_S=30
AUTO_INVESTIGATE_MAX_ATTEMPTS=5
AUTO_INVESTIGATE_DISPATCH_INTERVAL_S=15
AUTO_INVESTIGATE_RECONCILE_INTERVAL_S=60
AUTO_INVESTIGATE_MATERIALIZE_BATCH_SIZE=20

# --- Optional auto-response (ISSUE-109 / #613 Phase 1) ---
# Independent from AUTO_INVESTIGATE; mock-only; default off.
AUTO_RESPONSE_ENABLED=false
AUTO_RESPONSE_MIN_SEVERITY=high
AUTO_RESPONSE_MAX_AUTO_LEVEL=L1
# Comma-separated event_type allowlist; empty means all types eligible.
AUTO_RESPONSE_EVENT_TYPES=

# --- Tools ---
TOOL_MODE=mock

# --- Disposition / writeback ---
DISPOSITION_MODE=mock_xdr
DISPOSITION_ADAPTER_KIND=mock
# Mock XDR adapter URL (also used as SourceAdapter base URL in mock mode).
DISPOSITION_BASE_URL=http://mock-xdr:8100
# Mock read/write tokens are fixed in mock_xdr/state.py (mock-read-token / mock-write-token).
DISPOSITION_CREDENTIAL_REF=
ALLOW_XDR_WRITEBACK=false
# Tool registration gate (TOOL_MODE live/mixed). Does NOT unblock ActionExecution.
ALLOW_LIVE_SIDE_EFFECTS=false
# ISSUE-059 P0 freeze: true blocks execute_plan / writeback side-effect delivery.
BLOCK_LIVE_ACTION_EXECUTION=false
WRITEBACK_FIELD_ALLOWLIST=status,disposition,comment
WRITEBACK_MAX_RETRIES=5
# Poll interval (seconds) between UNKNOWN writeback LOOKUP attempts
WRITEBACK_LOOKUP_POLL_INTERVAL_S=1.0
# Inject artificial delay (ms) into readback confirmation path to exercise
# timeout handling.  Default 0 (disabled).  Only used in Mock mode.
# MIN_READBACK_DELAY_MS=0
SIMULATION_ENABLED=true

# --- Organization data (ISSUE-313 / ISSUE-114) ---
# Explicit path to Mock org change-window baseline. Compose defaults to the
# container path below; leave empty on host dev to auto-resolve data/organization/...
# CHANGE_WINDOW_BASELINE_PATH=/app/data/organization/change_windows.json
# When true (production only), missing/invalid baseline fails startup and may 503 /health.
# CHANGE_WINDOW_BASELINE_REQUIRED=false
# Comma-separated tenants that must exist when CHANGE_WINDOW_BASELINE_REQUIRED=true.
# CHANGE_WINDOW_BASELINE_REQUIRED_TENANTS=tenant-demo

# --- LLM ---
LLM_MODE=mock
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_PRIMARY_MODEL=mock-model
# ISSUE-243: off|structured|short_text. Production forbids short_text.
DECISION_RATIONALE_MODE=structured
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=30
# Optional outbound probe (default off — no external LLM calls on startup).
LLM_PROBE_ENABLED=false
LLM_PROBE_TTL_SECONDS=60
# chat | models — not all OpenAI-compatible vendors implement /models.
LLM_PROBE_METHOD=chat
# When true, degraded LLM health may surface as HTTP 503 on /health.
LLM_REQUIRED=false

# --- Playbook readiness (ISSUE-245 / #820) ---
# Compose backend defaults SEED_PLAYBOOK_RELEASE=true (entrypoint stages+activates
# data/knowledge/playbooks.json after migrate). Workers must leave this false.
# PLAYBOOK_REQUIRED=true is the demo health gate (503 if not ready); it does NOT
# refuse investigations — investigation stack stays fail-soft.
# PLAYBOOK_REQUIRED=false
# PLAYBOOK_RELEASE_REQUIRE_ACTIVE=false
# When true, adopt validated LLM event_type only if source+heuristic both resolve to OTHER.
TRIAGE_LLM_EVENT_TYPE_FALLBACK=false
LLM_AUDIT_WINDOW_MINUTES=60
# Optional event-detail chatbot; false keeps the route unmounted.
EVENT_CHAT_ENABLED=true
# Keep in sync with backend EVENT_CHAT_ENABLED when disabling event Q&A.
VITE_EVENT_CHAT_ENABLED=true

# --- Budget / guardrails (defaults; full wiring in later issues) ---
BUDGET_ENABLED=true
GLOBAL_TOKEN_BUDGET=1000000
EVENT_TOKEN_BUDGET=100000
EVENT_COST_BUDGET_USD=5.0
PER_AGENT_TOKEN_CAP=20000
QUALITY_JUDGE_ENABLED=false
GUARDRAIL_MODE=enforce
WM_STRICT=true

# --- Orchestration (later issues; safe defaults) ---
ORCHESTRATION_MODE=graph
REACT_ENABLED=false
TASK_MODE=background
# Set TASK_MODE=celery on the **backend** service when using the worker profile.
# Defaults to REDIS_URL when unset.
CELERY_BROKER_URL=
# Production / default demo safety: 30 minutes. Do NOT lower this globally just
# to make evaluations finish faster (ISSUE-256). For dynamic eval, use the
# commented eval profile below or a local `.env` overlay — never change the
# checked-in default.
APPROVAL_TIMEOUT_MINUTES=30

# --- Dynamic eval / gold-path profile (ISSUE-256, R2-010/011/014/017/018/019) ---
# Optional local overrides for repeatable mock-xdr full-loop demos. Copy into
# `.env` (or export) for eval only — production defaults above stay unchanged.
#
# Gold fixture: scripts/seed_mock_xdr_and_ingest.py +
#   POST /investigate {include_response_execution:true} +
#   scripts/dynamic_eval_approve.py (or make eval-full-loop).
# Forbidden as gold path: hand-crafted POST /events (Mock has no entities →
# Evidence fails) and finishing by waiting out APPROVAL_TIMEOUT_MINUTES.
#
# APPROVAL_TIMEOUT_MINUTES=3
# LLM_TIMEOUT_SECONDS=60
# EMBEDDING_MODE=mock
#
# Honesty notes (do not "fix" by changing product contracts):
# - Compose investigation worker uses celery `-c 2`. Triggering 3 investigations
#   at once will queue for minutes — prefer `--max-events 1` for eval timing.
# - Default EMBEDDING_MODE is mock even when LLM_MODE is a real openai_compatible
#   endpoint (mixed real-LLM + mock-embedding is expected unless you override both).
# - Bootstrap defaults remain generate_report=false / include_response=false;
#   set BOOTSTRAP_GENERATE_REPORT=true and/or BOOTSTRAP_INCLUDE_RESPONSE=true
#   for demo profiles (full_loop still requires scripted approve).

# --- OpenSearch (optional, disabled by default) ---
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=shadowtrace

# --- Neo4j graph mirror (ISSUE-082, P2 optional) ---
# NEO4J_ENABLED=true requires `docker compose --profile optional up -d neo4j`
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=shadowtrace

# --- OpenTelemetry observability (ISSUE-092, P2 optional) ---
# OTEL_ENABLED=true exports traces/metrics via OTLP; default off (zero overhead).
# Manual stack: docker compose -f infra/observability/docker-compose.observability.yml up -d
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=shadowtrace-backend
