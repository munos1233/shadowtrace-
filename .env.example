# ShadowTrace core environment variables (intro §4.7 + ISSUE-001 defaults)
# Copy to .env for local overrides. Defaults target Docker Compose service names.

# --- Application ---
APP_VERSION=0.1.0
APP_ENV=development

# --- API auth (ISSUE-004) ---
# DEV_AUTH_TOKENS maps a bearer token to a fixed Principal for local dev ONLY;
# it is rejected outright when APP_ENV=production. Leave empty in production.
# Example: {"analyst-token":{"subject":"analyst-1","roles":["analyst"]}}
DEV_AUTH_TOKENS=
# Only when enabled AND the direct client host is allowlisted are the identity
# headers (X-Auth-Subject / X-Auth-Roles) from a trusted reverse proxy honored.
TRUSTED_AUTH_PROXY_ENABLED=false
TRUSTED_PROXY_ALLOWLIST=

# --- Storage (P0 hard deps) ---
DATABASE_URL=postgresql+asyncpg://shadowtrace:shadowtrace@postgres:5432/shadowtrace
REDIS_URL=redis://redis:6379/0

# --- Source / ingestion ---
SOURCE_MODE=mock_xdr
SOURCE_READ_ONLY=true

# --- Tools ---
TOOL_MODE=mock

# --- Disposition / writeback ---
DISPOSITION_MODE=mock_xdr
DISPOSITION_ADAPTER_KIND=mock
DISPOSITION_BASE_URL=
DISPOSITION_CREDENTIAL_REF=
ALLOW_XDR_WRITEBACK=false
ALLOW_LIVE_SIDE_EFFECTS=false
WRITEBACK_FIELD_ALLOWLIST=status,disposition,comment
WRITEBACK_MAX_RETRIES=5
# Poll interval (seconds) between UNKNOWN writeback LOOKUP attempts
WRITEBACK_LOOKUP_POLL_INTERVAL_S=1.0
# Inject artificial delay (ms) into readback confirmation path to exercise
# timeout handling.  Default 0 (disabled).  Only used in Mock mode.
# MIN_READBACK_DELAY_MS=0
SIMULATION_ENABLED=true

# --- LLM ---
LLM_MODE=mock
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_PRIMARY_MODEL=mock-model
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=30
# Optional event-detail chatbot; false keeps the route unmounted.
EVENT_CHAT_ENABLED=true
# Keep in sync with backend EVENT_CHAT_ENABLED when disabling event Q&A.
VITE_EVENT_CHAT_ENABLED=true

# --- Budget / guardrails (defaults; full wiring in later issues) ---
BUDGET_ENABLED=true
GLOBAL_TOKEN_BUDGET=1000000
EVENT_TOKEN_BUDGET=100000
EVENT_COST_BUDGET_USD=5.0
PER_AGENT_TOKEN_CAP=20000
QUALITY_JUDGE_ENABLED=false
GUARDRAIL_MODE=enforce
WM_STRICT=true

# --- Orchestration (later issues; safe defaults) ---
ORCHESTRATION_MODE=graph
REACT_ENABLED=false
TASK_MODE=background
# Set TASK_MODE=celery on the **backend** service when using the worker profile.
# Defaults to REDIS_URL when unset.
CELERY_BROKER_URL=
APPROVAL_TIMEOUT_MINUTES=30

# --- OpenSearch (optional, disabled by default) ---
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=shadowtrace

# --- Neo4j graph mirror (ISSUE-082, P2 optional) ---
# NEO4J_ENABLED=true requires `docker compose --profile optional up -d neo4j`
NEO4J_ENABLED=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=shadowtrace
