{
  "name": "shadowtrace-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "verify:production-build": "node scripts/verify-no-dev-auth-token-in-build.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:mock": "playwright test -c e2e/playwright.mock.config.ts",
    "test:e2e:knowledge": "playwright test -c e2e/playwright.mock.config.ts",
    "test:e2e:install": "node scripts/ensure-playwright-browser.mjs",
    "test:e2e:platform-report": "node scripts/ensure-playwright-browser.mjs --report"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "5",
    "axios": "^1.18.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "6",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "6",
    "@testing-library/react": "16",
    "@testing-library/user-event": "14",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "24",
    "msw": "^2.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "2"
  }
}
